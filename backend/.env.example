# Copy to .env and fill in. Never commit .env.

# --- Domo AI Services (Text Generation) ---
DOMO_BASE_URL=https://gwcteq-partner.domo.com
DOMO_DEVELOPER_TOKEN=your_domo_developer_token
MODEL_NAME=domo.domo_ai.domogpt-large-v2.2:anthropic
DOMO_STRUCTURED_OUTPUT=true

# --- Database: Neon PostgreSQL, database "utilities" ---
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/utilities?sslmode=require&channel_binding=require
# READONLY_DATABASE_URL=postgresql://<readonly_user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/utilities?sslmode=require

# --- App ---
CORS_ORIGINS=http://localhost:5173

# --- Agent ---
SITE_NAME=Plant 01
AGENT_MAX_STEPS=6
